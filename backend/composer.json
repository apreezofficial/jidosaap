{
  "name": "jidosapp/backend",
  "description": "JidoSapp - AI-Powered WhatsApp Business Automation Backend (Vanilla PHP 8.3)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "vlucas/phpdotenv": "^5.6",
    "predis/predis": "^2.2",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {}
  }
}
