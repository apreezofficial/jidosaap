# ─────────────────────────────────────────────────────────────
# JidoSapp Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jidosapp
DB_USERNAME=jidosapp
DB_PASSWORD=secret

# For SQLite (local dev without Docker):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/jidosapp/backend/storage/database.sqlite

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# ─── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars
JWT_TTL=604800

# ─── Encryption (AES-256-GCM) ────────────────────────────────
# Used to encrypt WhatsApp access tokens and API credentials at rest.
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-32-char-random-encryption-key

# ─── Meta / WhatsApp Business Cloud API ──────────────────────
# Create a Meta App at https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=jidosapp_webhook_verify

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

# ─── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── S3-Compatible Storage ────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jidosapp-uploads
S3_REGION=us-east-1

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_DRIVER=file
RATE_LIMIT_PATH=storage/framework/ratelimit

# ─── Worker ───────────────────────────────────────────────────
WORKER_QUEUE=jidosapp:queue:default
WORKER_SLEEP=3
WORKER_MAX_TRIES=3
WORKER_TIMEOUT=60

# ─── Frontend URL (for Stripe redirect callbacks) ─────────────
FRONTEND_URL=http://localhost:3000
